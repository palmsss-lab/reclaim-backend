{
  "info": {
    "name": "Reclaim Private Notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use disposable records in an isolated environment. React uses session cookies and CSRF; these manual requests retain the supported non-browser Bearer API. Never export filled tokens."
  },
  "item": [
    {
      "name": "Private in-app notifications",
      "description": "Use only an isolated test environment and disposable records. Staff sends an OPEN missing report owner a possible match using only item_id; the server derives the recipient. No ownership decision or claim is created. Repeat the same match to check deduplication, including after marking read. Users list/count/read only their own notices; staff/wrong ability gets 403, another user notification ID gets 404. These requests reuse this collection's existing Bearer clients; React uses session cookies and CSRF. No email/push. See docs/NOTIFICATIONS_API.md.",
      "item": [
        {
          "name": "Staff: notify possible match (safe to retry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/staff/missing-reports/{{missing_report_id}}/possible-matches",
            "body": {
              "mode": "raw",
              "raw": "{\"item_id\": \"{{item_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List my notifications (capture first ID)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{base_url}}/my/notifications?per_page=20&page=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200 && pm.response.json().data.length) { pm.collectionVariables.set(\"notification_id\", String(pm.response.json().data[0].notification_id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "My unread notification count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{base_url}}/my/notifications/unread-count"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark own notification read (idempotent)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{base_url}}/my/notifications/{{notification_id}}/read"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark all own notifications read (idempotent)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{base_url}}/my/notifications/read-all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8001/api",
      "type": "string"
    },
    {
      "key": "staff_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "missing_report_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "item_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "notification_id",
      "value": "",
      "type": "string"
    }
  ]
}
